rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner() { return request.auth != null && request.auth.uid in ['w8g6tCU9KsbP7zKbodNWycLjdoi2', 'ZiU74F6Z6uUA7bAbPJQR9zoZ1ck1']; }
  match /site/content {
   allow read: if true;
   allow write: if owner();
  }
  match /photos/{photoId} {
   allow read: if true;
   allow create: if request.auth != null
     && request.resource.data.keys().hasOnly(['id','uid','date','title','path','createdAt','uploaderName','fileHash','imageHash'])
     && request.resource.data.fileHash is string && request.resource.data.fileHash.matches('^[a-f0-9]{64}$')
     && request.resource.data.imageHash is string && request.resource.data.imageHash.matches('^[a-f0-9]{64}$')
     && request.resource.data.id == photoId
     && request.resource.data.uid == request.auth.uid
     && request.resource.data.path == 'photos/' + request.auth.uid + '/' + photoId + '.jpg'
     && request.resource.data.uploaderName is string && request.resource.data.uploaderName.size() >= 1 && request.resource.data.uploaderName.size() <= 30
     && request.resource.data.title is string && request.resource.data.title.size() <= 80
     && request.resource.data.date is string && request.resource.data.date.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
     && request.resource.data.createdAt == request.time;
   allow update: if owner()
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','date','uploaderName','description','updatedAt'])
     && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 80
     && request.resource.data.date is string && request.resource.data.date.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
     && request.resource.data.uploaderName is string && request.resource.data.uploaderName.size() >= 1 && request.resource.data.uploaderName.size() <= 30
     && request.resource.data.description is string && request.resource.data.description.size() <= 500
     && request.resource.data.updatedAt == request.time;
   allow delete: if owner();
  }
  match /{document=**} { allow read, write: if false; }
 }
}
