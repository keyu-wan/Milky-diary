rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /photos/{uid}/{photoId}.jpg {
   allow read: if true;
   allow create: if request.auth != null && request.auth.uid == uid
     && photoId.matches('[A-Za-z0-9_-]{10,80}')
     && request.resource.size <= 10 * 1024 * 1024
     && request.resource.contentType == 'image/jpeg';
   allow delete: if request.auth != null && request.auth.uid in ['w8g6tCU9KsbP7zKbodNWycLjdoi2', 'ZiU74F6Z6uUA7bAbPJQR9zoZ1ck1'];
   allow update: if false;
  }
 }
}
